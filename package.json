{
  "name": "weather-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --quiet .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/e2e-smoke.ts",
    "test:visual": "tsx scripts/visual-smoke.ts",
    "preview:eink-reader": "tsx scripts/capture-eink-reader.ts",
    "deploy": "vite build && wrangler deploy",
    "fixture:fetch": "tsx scripts/fetch-fixture.ts",
    "demo:update": "tsx scripts/capture-screenshot.ts",
    "og:update": "tsx scripts/capture-og-image.ts"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "skewt": "^2.0.1",
    "suncalc": "^2.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "playwright": "^1.57.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.7"
  }
}
